---
import { getCollection } from 'astro:content';
import { PROFILE } from '../consts';

const blogPosts = await getCollection('blog');
const recentPosts = blogPosts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
---

<aside class="w-full lg:w-72 flex-shrink-0">
    <div class="sticky top-24 space-y-4">
        <!-- Navigation Menu -->
        <div class="sidebar-section border-b border-gray-100 dark:border-neutral-800 pb-4">
            <button class="sidebar-toggle w-full flex items-center justify-between group py-2" aria-expanded="true">
                <h3 class="text-xs font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 group-hover:text-[var(--accent-color)] transition-colors">Navigation</h3>
                <svg class="w-3 h-3 text-gray-400 transition-transform duration-300 transform rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div class="sidebar-content transition-all duration-300 overflow-hidden max-h-60 opacity-100 mt-4">
                <nav class="flex flex-col gap-1">
                    <a href="/" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-neutral-800/50 hover:text-[var(--accent-color)] transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                        About
                    </a>
                    <a href="/blog" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-neutral-800/50 hover:text-[var(--accent-color)] transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
                        Blog
                    </a>
                    <a href="/projects" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-neutral-800/50 hover:text-[var(--accent-color)] transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                        Projects
                    </a>
                    <a href="/cv" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-neutral-800/50 hover:text-[var(--accent-color)] transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        CV
                    </a>
                </nav>
            </div>
        </div>

        <!-- Profile / About Mini -->
        <div class="sidebar-section border-b border-gray-100 dark:border-neutral-800 pb-4">
            <button class="sidebar-toggle w-full flex items-center justify-between group py-2" aria-expanded="true">
                <h3 class="text-xs font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 group-hover:text-[var(--accent-color)] transition-colors">About Me</h3>
                <svg class="w-3 h-3 text-gray-400 transition-transform duration-300 transform rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div class="sidebar-content transition-all duration-300 overflow-hidden max-h-40 opacity-100 mt-2">
                <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                    {PROFILE.bio}
                </p>
            </div>
        </div>

        <!-- Recent Posts -->
        <div class="sidebar-section border-b border-gray-100 dark:border-neutral-800 pb-4">
            <button class="sidebar-toggle w-full flex items-center justify-between group py-2" aria-expanded="true">
                <h3 class="text-xs font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 group-hover:text-[var(--accent-color)] transition-colors">Recent Posts</h3>
                <svg class="w-3 h-3 text-gray-400 transition-transform duration-300 transform rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div class="sidebar-content transition-all duration-300 overflow-hidden max-h-96 opacity-100 mt-4">
                <ul class="space-y-4">
                    {recentPosts.length > 0 ? (
                        recentPosts.map((post) => (
                            <li>
                                <a href={`/blog/${post.id}/`} class="group block no-underline">
                                    <span class="block text-sm font-semibold text-gray-800 dark:text-gray-200 group-hover:text-[var(--accent-color)] transition-colors leading-snug mb-1">
                                        {post.data.title}
                                    </span>
                                    <time class="block text-[10px] font-bold font-mono text-gray-400 uppercase">
                                        {post.data.pubDate.toLocaleDateString('en-us', {
                                            month: 'short',
                                            day: 'numeric',
                                            year: 'numeric',
                                        })}
                                    </time>
                                </a>
                            </li>
                        ))
                    ) : (
                        <li class="text-sm text-gray-400 italic">No posts yet</li>
                    )}
                </ul>
            </div>
        </div>

        <!-- Social Links -->
        <div class="sidebar-section border-b border-gray-100 dark:border-neutral-800 pb-4">
            <button class="sidebar-toggle w-full flex items-center justify-between group py-2" aria-expanded="true">
                <h3 class="text-xs font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500 group-hover:text-[var(--accent-color)] transition-colors">Connect</h3>
                <svg class="w-3 h-3 text-gray-400 transition-transform duration-300 transform rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div class="sidebar-content transition-all duration-300 overflow-hidden max-h-40 opacity-100 mt-4">
                <div class="flex flex-col gap-2">
                    {PROFILE.links.github && (
                        <a href={PROFILE.links.github} target="_blank" class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-[var(--accent-color)] flex items-center gap-2 transition-colors">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                            GitHub
                        </a>
                    )}
                    {PROFILE.links.linkedin && (
                        <a href={PROFILE.links.linkedin} target="_blank" class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-[var(--accent-color)] flex items-center gap-2 transition-colors">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                            LinkedIn
                        </a>
                    )}
                    {PROFILE.links.email && (
                        <a href={`mailto:${PROFILE.links.email}`} class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-[var(--accent-color)] flex items-center gap-2 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                            Email
                        </a>
                    )}
                </div>
            </div>
        </div>
    </div>
</aside>

<script>
    const toggles = document.querySelectorAll('.sidebar-toggle');
    
    toggles.forEach(toggle => {
        toggle.addEventListener('click', () => {
            const content = toggle.nextElementSibling as HTMLElement;
            const icon = toggle.querySelector('svg');
            const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
            
            toggle.setAttribute('aria-expanded', (!isExpanded).toString());
            
            if (isExpanded) {
                content.style.maxHeight = '0';
                content.style.opacity = '0';
                content.style.marginTop = '0';
                icon?.classList.remove('rotate-180');
            } else {
                content.style.maxHeight = content.scrollHeight + 'px';
                content.style.opacity = '1';
                content.style.marginTop = '1rem';
                icon?.classList.add('rotate-180');
            }
        });
    });
</script>
