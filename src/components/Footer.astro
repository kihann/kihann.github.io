>
    &copy; {today.getFullYear()} Kihan Lee. Powered by <a
        href="https://astro.build"
        target="_blank"
        rel="noopener"
        class="hover:text-[var(--accent-color)]">Astro</a
    > and <a
        href="https://tailwindcss.com"
        target="_blank"
        rel="noopener"
        class="hover:text-[var(--accent-color)]">Tailwind CSS</a
    >.
</footer>
