---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title?: string;
  description? : string;
  image?: string;
  showSidebar?: boolean;
}

const {
  title = "Kihan Lee - Portfolio",
  description = "Personal portfolio and blog of Kihan Lee",
  image,
  showSidebar = false,
} = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body
    class="transition-colors duration-300 min-h-screen flex flex-col"
  >
    <Header />

    <div class="flex-grow w-full max-w-7xl mx-auto px-4 md:px-8 py-8 lg:py-12">
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-20">
        <main class="flex-grow w-full min-w-0">
          <slot />
        </main>
        
        {showSidebar && <Sidebar />}
      </div>
    </div>

    <Footer />
  </body>
</html>
